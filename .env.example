# Optional: public URL of the TorclixGroup API
VITE_API_URL=http://localhost:4000

# API / PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/torclix
DATABASE_SSL=true
PORT=4000

# Production authentication (OIDC/JWT provider)
AUTH_ISSUER=https://your-idp.example.com/
AUTH_AUDIENCE=torclix-api
AUTH_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
CORS_ORIGIN=https://app.example.com

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_PROJECT=p1
PUBLIC_URL=https://torclixgroup-api.onrender.com
